//
// Model-family material-layer setup for the M2 shading-mode layers (displacement /
// volume / reflection / cloaking / terrain).  Generated by scratchpad/gen_layers_m2.py
// to mirror the .fx SETUP_LAYER(<layer>) macro field-for-field, exactly like the M1
// setup<Layer>() builders in model_layers.slang.

implementing sc2_shaders;

// SC2_LAYER_<Prop>: a material-layer property reads from the permutation
// constant buffer once its switch is on, and from the `#define` until then.
#include "ps/model_layers_axes.slangh"

