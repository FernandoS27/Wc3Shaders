    c.b_iClamp                 = SC2_LAYER_Clamp(b_iCloakingNormalClamp);
    c.b_iFresnelMode           = SC2_LAYER_FresnelMode(b_iCloakingNormalFresnelMode);
    c.b_iFresnelTransformMode  = SC2_LAYER_FresnelTransformMode(b_iCloakingNormalFresnelTransformMode);
    c.b_iFresnelSaturate       = SC2_LAYER_FresnelSaturate(b_iCloakingNormalFresnelSaturate);
    c.b_iUseConstantColor      = b_iCloakingNormalUseConstantColor;
    c.b_iOp                    = SC2_LAYER_Op(b_iCloakingNormalOp);
    c.b_iIsRTTTexture          = SC2_LAYER_IsRTTTexture(b_iCloakingNormalIsRTTTexture);
    c.b_iTriPlanarUvId         = SC2_LAYER_TriPlanarUvId(b_iCloakingNormalTriPlanarUvId);
    c.p_vMultiplyAddAlphaTrans = psGlobals.vCloakingNormalMultiplyAddAlphaTrans;
    c.p_vAtlasParams           = psGlobals.vCloakingNormalAtlasParams;
    c.p_vFresnelExponentBiasScale = psGlobals.vCloakingNormalFresnelExponentBiasScale;
    c.p_cConstantColor         = psGlobals.cCloakingNormalConstantColor;
    c.p_vRTTTextureOffsetScale = psGlobals.vCloakingNormalRTTTextureOffsetScale;
    c.p_mFresnelTransform      = psGlobals.mCloakingNormalFresnelTransform;
    c.p_mUVTransform           = psGlobals.mCloakingNormalUVTransform;
    return c;
}
