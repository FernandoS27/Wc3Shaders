// ---- per-layer SLayerConfig builders ----------------------------------------
SLayerConfig setupDisplacementLayer()
{
    SLayerConfig c;
    c.b_iLayerEnable           = b_iDisplacementLayerEnable;
    c.b_iLayerId               = SC2_LAYER_LayerId(b_iDisplacementLayerId);
    c.b_iTextureType           = b_iDisplacementTextureType;
    c.b_iUVMapping             = SC2_LAYER_UVMapping(b_iDisplacementUVMapping);
    c.b_iTeamColorMode         = SC2_LAYER_TeamColorMode(b_iDisplacementTeamColorMode);
    c.b_iUVEmitter             = SC2_LAYER_UVEmitter(b_iDisplacementUVEmitter);
    c.b_iUseMask               = SC2_LAYER_UseMask(b_iDisplacementUseMask);
    c.b_iChannelSelect         = SC2_LAYER_ChannelSelect(b_iDisplacementChannelSelect);
    c.b_iInvert                = SC2_LAYER_Invert(b_iDisplacementInvert);
    c.b_iClamp                 = SC2_LAYER_Clamp(b_iDisplacementClamp);
    c.b_iFresnelMode           = SC2_LAYER_FresnelMode(b_iDisplacementFresnelMode);
    c.b_iFresnelTransformMode  = SC2_LAYER_FresnelTransformMode(b_iDisplacementFresnelTransformMode);
    c.b_iFresnelSaturate       = SC2_LAYER_FresnelSaturate(b_iDisplacementFresnelSaturate);
    c.b_iUseConstantColor      = b_iDisplacementUseConstantColor;
    c.b_iOp                    = SC2_LAYER_Op(b_iDisplacementOp);
    c.b_iIsRTTTexture          = SC2_LAYER_IsRTTTexture(b_iDisplacementIsRTTTexture);
    c.b_iTriPlanarUvId         = SC2_LAYER_TriPlanarUvId(b_iDisplacementTriPlanarUvId);
    c.p_vMultiplyAddAlphaTrans = psGlobals.vDisplacementMultiplyAddAlphaTrans;
    c.p_vAtlasParams           = psGlobals.vDisplacementAtlasParams;
    c.p_vFresnelExponentBiasScale = psGlobals.vDisplacementFresnelExponentBiasScale;
